#version 430 core

// pass1_count.comp — Phase 1: Project triangles to screen space and count per tile.
//
// Each thread processes one input triangle (identified by gl_GlobalInvocationID.x).
// The thread:
//   1. Reads 3 world-space vertices from the vertex+face SSBOs.
//   2. Projects each vertex to clip space using viewProjection, then to screen space.
//   3. Computes the screen-space AABB of the triangle.
//   4. Determines which tiles the AABB overlaps and atomically increments their counters.
//   5. Writes the projected triangle (screen-space positions, NDC depths, AABB) to a buffer
//      for use by pass3 (binning) and pass4 (rasterization).
//
// Triangles behind the camera (w ≤ 0) or with zero-area AABBs are marked invalid by
// writing aabbMin = (-1,-1) and are skipped in subsequent passes.
//
// TDR timeout guard: if a triangle's AABB spans more than 1024 tiles (e.g., a near-plane
// triangle covering most of the screen), it is also discarded. This prevents a single
// degenerate triangle from causing excessive atomic operations that stall the GPU.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// TILE_SIZE must match TileInfo::TILE_SIZE in TileData.h and clear_tiles.comp
const int TILE_SIZE = 16;

// Vertex: world-space position + smooth normal (std430 layout — see Mesh.h for padding)
struct Vertex {
    vec3 position;
    vec3 normal;
};

// Face: indices into the vertex buffer + per-face color (std430 layout — see Mesh.h)
struct Face {
    uvec3 indices;
    vec3 color;
    float padding;
};

// ProjectedTriangle: output of this pass, input to pass3/pass4 (std430 — see TileData.h)
struct ProjectedTriangle {
    vec2 v0;            // Screen-space position of vertex 0 (pixels, origin bottom-left)
    vec2 v1;            // Screen-space position of vertex 1
    vec2 v2;            // Screen-space position of vertex 2

    float depth0;       // NDC Z of vertex 0 (used for barycentric depth interpolation in pass4)
    float depth1;       // NDC Z of vertex 1
    float depth2;       // NDC Z of vertex 2

    ivec2 aabbMin;      // Screen-space AABB lower corner; (-1,-1) marks the triangle as invalid
    ivec2 aabbMax;      // Screen-space AABB upper corner

    uint originalFaceIndex; // Index into the Face SSBO — pass4 uses this to fetch color/normals
    uint padding[3];        // Padding to make sizeof(ProjectedTriangle) a multiple of 16 bytes
};

// SSBO bindings must match Renderer.cpp:
//   binding 0: vertex SSBO (bindVertexBuffer(0))
//   binding 1: face SSBO (bindFaceBuffer(1))
//   binding 2: projected triangle output buffer
//   binding 3: tile counter buffer (atomically incremented)
layout(std430, binding = 0) buffer VertexBuffer      { Vertex vertices[]; };
layout(std430, binding = 1) buffer FaceBuffer        { Face faces[]; };
layout(std430, binding = 2) buffer ProjectedTriangleBuffer { ProjectedTriangle projectedTriangles[]; };
layout(std430, binding = 3) buffer TileCounterBuffer { uint tileCounters[]; };

// Set by Renderer::render(): combined view × projection matrix, screen resolution, tile grid size
uniform mat4  viewProjection;
uniform ivec2 screenSize;
uniform ivec2 numTiles;

// Project a world-space position to screen space.
// Returns the 2D screen position (pixels, origin bottom-left) and writes:
//   depth — NDC Z in [-1, 1], used for barycentric depth interpolation
//   valid — false if the vertex is behind the near plane (w ≤ 0), which would produce
//           a negative perspective divide and an incorrect screen position
vec2 projectToScreen(vec3 worldPos, out float depth, out bool valid) {
    vec4 clipSpace = viewProjection * vec4(worldPos, 1.0);

    // Reject vertices behind the camera (clip-space w ≤ 0 means z > -w, i.e., behind near plane)
    if (clipSpace.w <= 0.0001) {
        valid = false;
        depth = 1e10;
        return vec2(0.0);
    }

    // Perspective divide: NDC coordinates in [-1, 1] on each axis
    vec3 ndc = clipSpace.xyz / clipSpace.w;

    depth = ndc.z; // Store NDC Z for per-pixel depth interpolation in pass4
    valid = true;

    // Map NDC X/Y from [-1,1] to [0, screenSize] (OpenGL NDC origin is bottom-left)
    vec2 screenPos;
    screenPos.x = (ndc.x * 0.5 + 0.5) * screenSize.x;
    screenPos.y = (ndc.y * 0.5 + 0.5) * screenSize.y;

    return screenPos;
}

// Compute the integer screen-space AABB for a triangle from its three screen-space vertices.
// Uses floor/ceil to guarantee the AABB covers all pixels that the triangle might touch.
// The AABB is clamped to [0, screenSize-1] so tile lookups never go out of bounds.
// Returns the size of the AABB (used to discard zero-area triangles).
ivec2 calculateAABB(vec2 v0, vec2 v1, vec2 v2, out ivec2 aabbMin, out ivec2 aabbMax) {
    vec2 minF = min(min(v0, v1), v2);
    vec2 maxF = max(max(v0, v1), v2);

    // floor on min → include partial pixels on the left/bottom edge
    // ceil on max  → include partial pixels on the right/top edge
    aabbMin = ivec2(floor(minF));
    aabbMax = ivec2(ceil(maxF));

    // Clamp to viewport to prevent tile index overflow
    aabbMin = clamp(aabbMin, ivec2(0), screenSize - ivec2(1));
    aabbMax = clamp(aabbMax, ivec2(0), screenSize - ivec2(1));

    return aabbMax - aabbMin;
}

void main() {
    uint triangleID = gl_GlobalInvocationID.x;
    uint faceCount = faces.length();

    // Guard: extra threads in the last workgroup have no triangle to process
    if (triangleID >= faceCount) {
        return;
    }

    Face face = faces[triangleID];

    // Fetch the three world-space vertex positions
    vec3 v0World = vertices[face.indices.x].position;
    vec3 v1World = vertices[face.indices.y].position;
    vec3 v2World = vertices[face.indices.z].position;

    bool valid0, valid1, valid2;
    float depth0, depth1, depth2;

    // Project all 3 vertices; if any is behind the camera, discard the whole triangle
    vec2 v0Screen = projectToScreen(v0World, depth0, valid0);
    vec2 v1Screen = projectToScreen(v1World, depth1, valid1);
    vec2 v2Screen = projectToScreen(v2World, depth2, valid2);

    if (!valid0 || !valid1 || !valid2) {
        // Mark as invalid — pass3 and pass4 will skip triangles with aabbMin.x < 0
        projectedTriangles[triangleID].aabbMin = ivec2(-1);
        projectedTriangles[triangleID].aabbMax = ivec2(-1);
        return;
    }

    ivec2 aabbMin, aabbMax;
    ivec2 aabbSize = calculateAABB(v0Screen, v1Screen, v2Screen, aabbMin, aabbMax);

    // Discard zero-area triangles (edge-on or degenerate after projection)
    if (aabbSize.x <= 0 || aabbSize.y <= 0) {
        projectedTriangles[triangleID].aabbMin = ivec2(-1);
        projectedTriangles[triangleID].aabbMax = ivec2(-1);
        return;
    }

    // Write the projected triangle to the output buffer for pass3/pass4
    projectedTriangles[triangleID].v0              = v0Screen;
    projectedTriangles[triangleID].v1              = v1Screen;
    projectedTriangles[triangleID].v2              = v2Screen;
    projectedTriangles[triangleID].depth0          = depth0;
    projectedTriangles[triangleID].depth1          = depth1;
    projectedTriangles[triangleID].depth2          = depth2;
    projectedTriangles[triangleID].aabbMin         = aabbMin;
    projectedTriangles[triangleID].aabbMax         = aabbMax;
    projectedTriangles[triangleID].originalFaceIndex = triangleID;

    // --- Tile coverage and counter increment ---
    // Convert screen-space AABB to tile coordinates (integer divide by TILE_SIZE)
    ivec2 tileMin = aabbMin / TILE_SIZE;
    ivec2 tileMax = aabbMax / TILE_SIZE;

    tileMin = clamp(tileMin, ivec2(0), numTiles - ivec2(1));
    tileMax = clamp(tileMax, ivec2(0), numTiles - ivec2(1));

    // TDR guard: a triangle spanning >1024 tiles (e.g., 32×32) would cause too many
    // atomic operations and potentially stall the GPU long enough to trigger a TDR reset.
    // Discard such extreme cases rather than risk a GPU hang.
    ivec2 tileRange = tileMax - tileMin + ivec2(1);
    if (tileRange.x * tileRange.y > 1024) {
        projectedTriangles[triangleID].aabbMin = ivec2(-1);
        projectedTriangles[triangleID].aabbMax = ivec2(-1);
        return;
    }

    // Atomically increment the counter for every tile the AABB overlaps.
    // These counts will be prefix-summed in pass2 to compute per-tile offsets.
    for (int ty = tileMin.y; ty <= tileMax.y; ty++) {
        for (int tx = tileMin.x; tx <= tileMax.x; tx++) {
            uint tileIndex = ty * numTiles.x + tx;
            atomicAdd(tileCounters[tileIndex], 1);
        }
    }
}

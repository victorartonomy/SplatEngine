#version 430 core
#extension GL_ARB_gpu_shader_int64 : require

// pass4_rasterize_tiled.comp — Phase 3: Per-pixel rasterization, depth testing, and shading.
//
// Each workgroup processes one 16×16 pixel tile. Each invocation processes one pixel.
// For the pixel, the shader:
//   1. Determines which tile it belongs to and reads the tile's triangle list.
//   2. For each triangle in the list, runs a point-in-triangle test.
//   3. On pass: computes barycentric coordinates, interpolates depth, runs atomicMin depth test.
//   4. On depth test pass: interpolates normal + world position, runs the selected shading model.
//   5. Writes the shaded color to the output image.
//
// Depth encoding:
//   NDC depth (in [-1,1]) is mapped to a uint32 in [0, 0xFFFFFFFF] by:
//     nd = clamp((depth+1)*0.5, 0, 1)
//     depthUInt = uint(nd * 4294967295)
//   imageAtomicMin compares these uints. Smaller uint = closer (lower NDC Z = nearer).
//   The clear pass initializes all pixels to 0xFFFFFFFF ("infinitely far").
//
// Shading models (selected by the `shadingModel` uniform):
//   0 = Blinn-Phong: diffuse (NdotL) + specular (H = normalize(L+V), shininess 64)
//   1 = PBR metallic-roughness: Cook-Torrance BRDF
//         D = GGX normal distribution
//         G = Smith geometry masking-shadowing
//         F = Schlick Fresnel approximation

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

const int   TILE_SIZE = 16;
const float PI = 3.14159265359;

// Output color image (RGBA32F, write-only)
layout(rgba32f, binding = 0) uniform image2D outputImage;
// Depth buffer (R32UI, read-write for imageAtomicMin)
// `coherent` ensures atomic writes from different invocations are visible to each other
layout(r32ui, binding = 1) coherent uniform uimage2D depthBuffer;

// Vertex: world-space position (after model matrix) and smooth normal (after normal matrix)
// Vertex: world-space position, smooth normal, and UV coordinates (48 bytes in std430).
// vec3 fields each consume a 16-byte slot; vec2 uv sits at byte 32; two float pads bring
// the struct to 48 bytes. Must match C++ Vertex in Mesh.h.
struct Vertex {
    vec3  position;   // bytes  0–11 (+4 implicit pad)
    vec3  normal;     // bytes 16–27 (+4 implicit pad)
    vec2  uv;         // bytes 32–39: texture coordinates (planar XY projection)
    float _p0;        // bytes 40–43: explicit pad
    float _p1;        // bytes 44–47: explicit pad
};

// Face: vertex indices into the merged vertex buffer + per-face color + material slot
struct Face {
    uvec3 indices;
    vec3  color;       // per-face RGB tint (from COFF file)
    uint  materialID;  // index into materials[] SSBO (binding 8)
};

// ProjectedTriangle: pass1 output — screen-space positions, NDC depths, AABB
struct ProjectedTriangle {
    vec2  v0;
    vec2  v1;
    vec2  v2;

    float depth0;
    float depth1;
    float depth2;

    ivec2 aabbMin;
    ivec2 aabbMax;

    uint originalFaceIndex;
    uint padding[3];
};

// GPULight: 128-byte std430 struct (see Light.h for byte-offset layout).
// Each vec3 is followed by a float packing to satisfy std430 16-byte alignment.
// Layout grew from 64→128 bytes when shadow mapping was added — must match the
// C++ GPULight struct field-for-field, including the trailing mat4.
struct GPULight {
    vec3  position;    float type;          // type: 0=Directional, 1=Point, 2=Spot (stored as float)
    vec3  direction;   float intensity;
    vec3  color;       float range;
    float innerCos;    float outerCos;      // Pre-computed cos(innerCone/outerCone)
    float castsShadow; float _pad0;         // 1.0 if this light casts shadows, 0.0 otherwise
    mat4  lightViewProjection;              // World→light-clip matrix for shadow lookups
};

// GPUMaterial — 32-byte std430 struct. See GPUMaterial in Mesh.h for byte-offset layout.
// Slot 0 is the default white/neutral material (albedo=1,1,1; metallic=0; roughness=0.5; emissive=0; alpha=1).
// final_albedo = face.color × mat.albedo → default preserves original face color.
// textureID: -1 = no texture (face.color × albedo only); 0+ = layer index in textureAtlas.
// alpha: 1.0 = fully opaque (depth-tested, single winner per pixel).
//        < 0.99 = transparent → fragment is accumulated via WBOIT into the OIT SSBOs.
struct GPUMaterial {
    vec3  albedo;     float metallic;    // bytes  0–15
    float roughness;  float emissive;    // bytes 16–23
    int   textureID;  float alpha;       // bytes 24–31 (alpha replaces former _p1 padding)
};

// SSBO binding layout (must match Renderer.cpp pass4 setup):
//   binding 2: vertex SSBO
//   binding 3: face SSBO
//   binding 4: projected triangle buffer (pass1 output)
//   binding 5: tile offset buffer (pass2 output — per-tile start in triangleList)
//   binding 6: triangle list buffer (pass3 output — flat list of triangle IDs per tile)
//   binding 7: light SSBO (LightManager output — GPULight array)
//   binding 8: material SSBO (MaterialManager output — GPUMaterial array)
//   bindings 9-13: OIT accumulation SSBOs (see below)
layout(std430, binding = 2) buffer VertexBuffer            { Vertex vertices[]; };
layout(std430, binding = 3) buffer FaceBuffer              { Face faces[]; };
layout(std430, binding = 4) buffer ProjectedTriangleBuffer { ProjectedTriangle projectedTriangles[]; };
layout(std430, binding = 5) buffer TileOffsetBuffer        { uint tileOffsets[]; };
layout(std430, binding = 6) buffer TriangleListBuffer      { uint triangleList[]; };
layout(std430, binding = 7) buffer LightBuffer             { GPULight lights[]; };
layout(std430, binding = 8) buffer MaterialBuffer          { GPUMaterial materials[]; };

// OIT accumulation buffers — written by this pass, read by pass5_oit_composite.comp.
//
// Each buffer stores one float per pixel, packed into a uint32 using floatBitsToUint so
// that it can live in a plain SSBO without needing any GLSL extension.
//
// Pixel index:  idx = pixelCoords.y * screenSize.x + pixelCoords.x
//
// No atomics are needed here: the tile layout assigns exactly one thread per pixel
// (16×16 tile = 16×16 threads), and tiles are non-overlapping. Each pixel is therefore
// written by exactly one thread — plain SSBO stores are safe.
//
// Contents after pass4 completes (per pixel):
//   oitAccumR/G/B: sum(channel * alpha * weight)  — WBOIT weighted color
//   oitAccumA:     sum(alpha * weight)             — WBOIT weighted alpha sum
//   oitReveal:     product(1 - alpha_i)            — accumulated transmittance [0,1]
//                  1.0 = no transparent fragments; 0.0 = fully covered
layout(std430, binding = 9)  buffer OITAccumR { uint oitAccumR[]; };
layout(std430, binding = 10) buffer OITAccumG { uint oitAccumG[]; };
layout(std430, binding = 11) buffer OITAccumB { uint oitAccumB[]; };
layout(std430, binding = 12) buffer OITAccumA { uint oitAccumA[]; };
layout(std430, binding = 13) buffer OITReveal  { uint oitReveal[];  };

// Shadow map (R32UI) bound at image unit 9. Read with imageLoad and bit-cast back to float.
// Written by shadow_pass.comp using floatBitsToUint(depth) + imageAtomicMin.
// Image binding 2 (image units are a separate namespace from SSBO bindings, and the
// hardware limit is often 8 — bindings 0/1 hold the output and depth images).
layout(r32ui, binding = 2) readonly uniform uimage2D shadowMap;

uniform ivec2 screenSize;
uniform ivec2 numTiles;
uniform int   numLights;
uniform int   numMaterials;
uniform vec3  cameraPos;
uniform int   shadingModel; // 0 = Blinn-Phong, 1 = PBR

// Shadow mapping uniforms — set by Renderer::render() for the primary shadow-casting light.
uniform mat4  shadowViewProjection; // Same matrix used by shadow_pass.comp
uniform ivec2 shadowMapSize;        // Resolution of the shadow map texture
uniform int   shadowLightIndex;     // Index in lights[] of the light that owns shadowMap (-1 = none)

// Texture array holding all loaded textures as layers (GL_TEXTURE_2D_ARRAY, unit 0).
// Indexed with vec3(u, v, layerIndex); only sampled when GPUMaterial::textureID >= 0.
uniform sampler2DArray textureAtlas;

// -----------------------------------------------
// Utility
// -----------------------------------------------

// 2D signed area function used for the point-in-triangle test.
// Returns the signed area of the parallelogram spanned by (p2→p1) and (p2→p3).
// Positive value = p1 is to the left of the directed edge p2→p3 (counter-clockwise winding).
float sign2D(vec2 p1, vec2 p2, vec2 p3) {
    return (p1.x - p3.x) * (p2.y - p3.y) - (p2.x - p3.x) * (p1.y - p3.y);
}

// Point-in-triangle test using edge functions (sign2D for each edge).
// If all three sign2D values have the same sign (all positive or all negative),
// the point lies inside the triangle (handles both CW and CCW winding).
// Returns true on pass; writes barycentric coordinates into `barycentric`:
//   barycentric.x = weight for vertex 0
//   barycentric.y = weight for vertex 1
//   barycentric.z = weight for vertex 2
// Used to interpolate depth, normals, and world position inside the triangle.
bool pointInTriangle(vec2 pt, vec2 v0, vec2 v1, vec2 v2, out vec3 barycentric) {
    float d1 = sign2D(pt, v0, v1);
    float d2 = sign2D(pt, v1, v2);
    float d3 = sign2D(pt, v2, v0);

    bool hasNeg = (d1 < 0.0) || (d2 < 0.0) || (d3 < 0.0);
    bool hasPos = (d1 > 0.0) || (d2 > 0.0) || (d3 > 0.0);

    // Mixed signs → point is outside the triangle (on different sides of different edges)
    if (hasNeg && hasPos) return false;

    // Degenerate triangle (zero or near-zero area) — skip to avoid division by near-zero
    float totalArea = d1 + d2 + d3;
    if (abs(totalArea) < 0.0001) return false;

    // Normalize edge function values by total area to get barycentric coordinates in [0,1]
    barycentric.x = d2 / totalArea; // Weight for vertex 0 (opposite to edge v1→v2)
    barycentric.y = d3 / totalArea; // Weight for vertex 1 (opposite to edge v2→v0)
    barycentric.z = d1 / totalArea; // Weight for vertex 2 (opposite to edge v0→v1)
    return true;
}

// Encode NDC depth (in [-1,1]) to a uint32 for imageAtomicMin depth testing.
// Maps [-1,1] → [0,1] → [0, 0xFFFFFFFF].
// Smaller encoded value = closer to the camera.
// The clear pass sets all pixels to 0xFFFFFFFF so any first write always wins.
uint encodeDepth(float depth) {
    float nd = clamp((depth + 1.0) * 0.5, 0.0, 1.0);
    return uint(nd * 4294967295.0);
}

// -----------------------------------------------
// Shadow mapping
// -----------------------------------------------

// Sample the shadow map for a given world-space surface point and return a
// shadow factor in [0, 1]:
//   1.0 = fully lit (no occluder between this point and the light)
//   0.0 = fully in shadow
//
// The depth was stored by shadow_pass.comp as floatBitsToUint(depth01), where
// depth01 = (NDC_z + 1) * 0.5. We undo that here with uintBitsToFloat() and a
// matching NDC remap on the current pixel's light-space position.
//
// `N` and `L` are passed in so we can apply a slope-scaled bias: surfaces nearly
// parallel to the light direction need a larger bias to avoid self-shadowing
// "shadow acne" stripes from precision error in depth comparison.
float computeShadowFactor(vec3 worldPos, vec3 N, vec3 L) {
    // Project this surface point into the shadow map's clip space.
    vec4 lp = shadowViewProjection * vec4(worldPos, 1.0);
    if (lp.w <= 0.0001) return 1.0; // Behind the light — treat as lit (caller already checked NdotL)

    vec3 ndc = lp.xyz / lp.w;
    // Outside the light frustum → no shadow info available, fall back to lit.
    if (any(lessThan(ndc.xyz, vec3(-1.0))) || any(greaterThan(ndc.xyz, vec3(1.0))))
        return 1.0;

    // Map NDC xy ∈ [-1,1] to integer texel coordinates.
    vec2 uv = ndc.xy * 0.5 + 0.5;
    ivec2 texel = ivec2(uv * vec2(shadowMapSize));
    texel = clamp(texel, ivec2(0), shadowMapSize - ivec2(1));

    // Decode the stored closest-occluder depth.
    uint  storedBits  = imageLoad(shadowMap, texel).r;
    float storedDepth = uintBitsToFloat(storedBits);

    // Convert this pixel's NDC depth to the same [0,1] encoding shadow_pass uses.
    float currentDepth = clamp((ndc.z + 1.0) * 0.5, 0.0, 1.0);

    // Slope-scaled bias: more bias when the light grazes the surface.
    // 0.0005 is the constant floor to fight precision error on flat-on surfaces.
    float bias = max(0.005 * (1.0 - dot(N, L)), 0.0005);

    // Standard binary depth compare. Could be expanded to a 3×3 PCF kernel later.
    return (currentDepth - bias > storedDepth) ? 0.0 : 1.0;
}

// -----------------------------------------------
// PBR helpers (Cook-Torrance BRDF components)
// -----------------------------------------------

// GGX (Trowbridge-Reitz) normal distribution function.
// D(H) = α² / (π * ((NdotH)² * (α²-1) + 1)²)
// Describes how microfacet normals are distributed around H (half-vector).
// Higher roughness → broader highlight; lower roughness → sharper, mirror-like.
float distributionGGX(vec3 N, vec3 H, float roughness) {
    float a   = roughness * roughness; // Perceptual roughness → α
    float a2  = a * a;
    float NdotH = max(dot(N, H), 0.0);
    float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom);
}

// Schlick-GGX geometry function for one direction (view or light).
// Approximates the shadowing/masking of microfacets.
// k = (roughness+1)² / 8 is the remapped roughness for direct lighting.
float geometrySchlickGGX(float NdotV, float roughness) {
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / (NdotV * (1.0 - k) + k);
}

// Smith's combined geometry function (view + light masking-shadowing).
// G(N,V,L) = G_sub(N,V) * G_sub(N,L)
float geometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
    return geometrySchlickGGX(max(dot(N, V), 0.0), roughness)
         * geometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

// Schlick Fresnel approximation.
// F(θ) = F0 + (1 - F0) * (1 - cosθ)^5
// F0 is the specular reflectance at normal incidence (0° from normal).
// For non-metals F0 ≈ (0.04, 0.04, 0.04); for metals F0 = albedo.
vec3 fresnelSchlick(float cosTheta, vec3 F0) {
    return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// -----------------------------------------------
// Light attenuation
// -----------------------------------------------

// Compute the light direction L and attenuation factor for a given GPULight.
// Writes L as the unit vector pointing *from the surface toward the light*.
// Returns attenuation in [0,1]:
//   Directional: attenuation = 1.0 (infinite-distance, no falloff)
//   Point: inverse-square falloff scaled by range: 1 / (1 + (dist/range)²)
//   Spot: point falloff × smooth cone fade using smoothstep on cosine angles
//
// The type is stored as a float (0.0, 1.0, 2.0) and rounded to an int to avoid
// float comparison errors from GPU rounding.
float computeAttenuation(GPULight light, vec3 worldPos, out vec3 L) {
    int ltype = int(light.type + 0.5); // Round float type to nearest int

    if (ltype == 0) {
        // Directional: L = opposite of light direction (direction points away from source)
        L = normalize(-light.direction);
        return 1.0; // No distance attenuation for infinite-distance directional lights
    }

    vec3 toLight = light.position - worldPos;
    float dist = length(toLight);
    L = toLight / max(dist, 0.0001); // Normalize safely (avoid division by ~0)

    // Physically-based inverse-square falloff, bounded by range to avoid infinite reach
    float atten = 1.0 / (1.0 + (dist / max(light.range, 0.001)) * (dist / max(light.range, 0.001)));

    if (ltype == 2) {
        // Spot: apply cone fade on top of point attenuation.
        // theta = cosine of the angle between (-L) and the light's forward direction.
        // smoothstep maps [outerCos, innerCos] → [0,1]: 0 at outer edge, 1 in full-intensity cone.
        // Pre-computed innerCos/outerCos values avoid calling acos() here.
        float theta = dot(-L, normalize(light.direction));
        float epsilon = light.innerCos - light.outerCos; // Must be > 0 (inner < outer angle → inner > outer cosine)
        float spotFade = clamp((theta - light.outerCos) / max(epsilon, 0.0001), 0.0, 1.0);
        atten *= spotFade;
    }

    return atten;
}

// -----------------------------------------------
// Shading models
// -----------------------------------------------

// Blinn-Phong shading: fast approximation for diffuse + specular lighting.
//   Diffuse:  lambertian (albedo * NdotL)
//   Specular: Blinn's half-vector H = normalize(L+V), shininess exponent 64
//   Ambient:  constant 3% of albedo to prevent fully unlit areas
vec3 shadeBlinnPhong(vec3 albedo, vec3 N, vec3 V, vec3 worldPos) {
    vec3 result = vec3(0.03) * albedo; // Ambient term

    for (int i = 0; i < numLights; i++) {
        vec3 L;
        float atten = computeAttenuation(lights[i], worldPos, L);
        if (atten < 0.001) continue; // Skip negligibly attenuated lights

        float NdotL = max(dot(N, L), 0.0);
        vec3 H = normalize(L + V); // Blinn's half-vector: bisector of L and V
        float spec = pow(max(dot(N, H), 0.0), 64.0); // Specular highlight (shininess = 64)

        // Shadow modulation: only the designated shadow-casting light is occluded.
        // Ambient (the 0.03*albedo above) is intentionally left unmultiplied so shadows
        // are dark grey rather than pitch black.
        float shadow = 1.0;
        if (i == shadowLightIndex && lights[i].castsShadow > 0.5)
            shadow = computeShadowFactor(worldPos, N, L);

        result += lights[i].color * lights[i].intensity * atten * shadow
                * (albedo * NdotL + vec3(0.3) * spec); // Diffuse + specular contribution
    }
    return result;
}

// PBR (Cook-Torrance) shading with metallic-roughness workflow.
// metallic and roughness are now per-material parameters from the GPUMaterial SSBO.
// F0: specular reflectance at normal incidence — 0.04 for dielectrics, albedo for metals.
//
// BRDF = (kD * albedo/π + specular) * radiance * NdotL
//   where specular = (D * G * F) / (4 * NdotV * NdotL)
//   kD = diffuse weight = (1 - F) * (1 - metallic)  [energy conservation]
vec3 shadePBR(vec3 albedo, vec3 N, vec3 V, vec3 worldPos, float metallic, float roughness) {
    // F0: linear interpolation between dielectric (0.04) and metallic (albedo)
    vec3 F0 = mix(vec3(0.04), albedo, metallic);

    vec3 result = vec3(0.03) * albedo; // Ambient term

    for (int i = 0; i < numLights; i++) {
        vec3 L;
        float atten = computeAttenuation(lights[i], worldPos, L);
        if (atten < 0.001) continue;

        float NdotL = max(dot(N, L), 0.0);
        if (NdotL <= 0.0) continue; // Back-face to this light — no contribution

        vec3 H = normalize(V + L); // Half-vector for Cook-Torrance

        // Cook-Torrance specular BRDF components
        float D = distributionGGX(N, H, roughness);  // Microfacet distribution
        float G = geometrySmith(N, V, L, roughness);  // Geometry masking-shadowing
        vec3  F = fresnelSchlick(max(dot(H, V), 0.0), F0); // Fresnel reflectance

        // Specular term: (D * G * F) / (4 * NdotV * NdotL)
        // Clamp denominator to avoid divide-by-zero when view/light is near grazing
        vec3 specular = (D * G * F)
            / max(4.0 * max(dot(N, V), 0.001) * NdotL, 0.001);

        // Diffuse weight: energy remaining after specular reflection
        // kD = 0 for metals (all energy goes into specular)
        vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);

        // Shadow modulation — same rule as Blinn-Phong: only the assigned shadow caster.
        float shadow = 1.0;
        if (i == shadowLightIndex && lights[i].castsShadow > 0.5)
            shadow = computeShadowFactor(worldPos, N, L);

        vec3 radiance = lights[i].color * lights[i].intensity * atten * shadow;
        result += (kD * albedo / PI + specular) * radiance * NdotL;
    }
    return result;
}

// -----------------------------------------------
// Main
// -----------------------------------------------

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    // Guard: discard threads outside the viewport (edge tiles may extend beyond screen).
    // Note: OIT buffers are sized width×height, so out-of-bounds threads must NOT write.
    if (pixelCoords.x >= screenSize.x || pixelCoords.y >= screenSize.y)
        return;

    // Flat pixel index into the OIT SSBOs (row-major, matching the buffer allocation).
    int pixelIdx = pixelCoords.y * screenSize.x + pixelCoords.x;

    // Determine which tile this pixel belongs to and read its triangle range.
    ivec2 tileCoords = pixelCoords / TILE_SIZE;
    uint tileIndex = tileCoords.y * numTiles.x + tileCoords.x;

    // [tileStart, tileEnd) is the half-open range of this tile's entries in triangleList[].
    uint tileStart = tileOffsets[tileIndex];
    uint tileEnd   = tileOffsets[tileIndex + 1];
    uint numTrianglesInTile = tileEnd - tileStart;

    // Initialize output pixel to black (background color).
    imageStore(outputImage, pixelCoords, vec4(0.0, 0.0, 0.0, 1.0));

    // Thread-local OIT accumulation state for this pixel.
    // These live entirely in registers — no memory until the final write below.
    // Initialized to "no transparent fragments" state:
    //   accum channels = 0 (no contribution yet)
    //   reveal = 1.0    (full transmittance — nothing is blocking the opaque surface)
    float localAccumR = 0.0;
    float localAccumG = 0.0;
    float localAccumB = 0.0;
    float localAccumA = 0.0;
    float localReveal = 1.0;

    // Process triangles only if this tile has any (avoids the loop overhead entirely).
    if (numTrianglesInTile > 0) {
        // Test against the center of the pixel (not the corner) for correct sub-pixel coverage.
        vec2 pixelCenter = vec2(pixelCoords) + vec2(0.5);

        for (uint i = 0; i < numTrianglesInTile; i++) {
            uint triangleID = triangleList[tileStart + i];
            ProjectedTriangle tri = projectedTriangles[triangleID];

            // Point-in-triangle test with barycentric coordinate output.
            vec3 barycentric;
            if (!pointInTriangle(pixelCenter, tri.v0, tri.v1, tri.v2, barycentric))
                continue;

            // Barycentric interpolation of NDC depth (used for depth testing and WBOIT weight).
            float interpolatedDepth = barycentric.x * tri.depth0 +
                                      barycentric.y * tri.depth1 +
                                      barycentric.z * tri.depth2;

            // Read face and resolve material early so we can branch on alpha.
            // Clamping materialID prevents out-of-bounds reads on corrupt data.
            Face face = faces[tri.originalFaceIndex];
            GPUMaterial mat = materials[clamp(int(face.materialID), 0, numMaterials - 1)];
            float matAlpha = mat.alpha;

            if (matAlpha >= 0.99) {
                // ── Opaque path (unchanged from pre-OIT behavior) ──────────────────────
                // Atomic min depth test: only the closest opaque triangle writes color.
                // imageAtomicMin returns the OLD value; if our depth is smaller, we won.
                uint depthUInt = encodeDepth(interpolatedDepth);
                uint oldDepth  = imageAtomicMin(depthBuffer, pixelCoords, depthUInt);

                if (depthUInt <= oldDepth) {
                    uvec3 idx = face.indices;

                    // Interpolate per-vertex normal; renormalize because barycentric
                    // blending of unit vectors is not generally unit-length.
                    vec3 N = normalize(barycentric.x * vertices[idx.x].normal
                                     + barycentric.y * vertices[idx.y].normal
                                     + barycentric.z * vertices[idx.z].normal);

                    // World-space position for light distance and direction calculations.
                    vec3 worldPos = barycentric.x * vertices[idx.x].position
                                  + barycentric.y * vertices[idx.y].position
                                  + barycentric.z * vertices[idx.z].position;

                    // Per-vertex UV (planar XY projection from COFFParser).
                    vec2 uv = barycentric.x * vertices[idx.x].uv
                            + barycentric.y * vertices[idx.y].uv
                            + barycentric.z * vertices[idx.z].uv;

                    // Unit vector from surface toward the camera for specular calculations.
                    vec3 V = normalize(cameraPos - worldPos);

                    // Combine face tint, material albedo, and optional texture sample.
                    vec3 albedo;
                    if (mat.textureID >= 0) {
                        vec4 texSample = texture(textureAtlas, vec3(uv, float(mat.textureID)));
                        albedo = face.color * mat.albedo * texSample.rgb;
                    } else {
                        albedo = face.color * mat.albedo;
                    }

                    // Shade with the selected lighting model.
                    vec3 color;
                    if (shadingModel == 1)
                        color = shadePBR(albedo, N, V, worldPos, mat.metallic, mat.roughness);
                    else
                        color = shadeBlinnPhong(albedo, N, V, worldPos);

                    // Self-emission adds on top of the shaded result.
                    color += albedo * mat.emissive;

                    imageStore(outputImage, pixelCoords, vec4(color, 1.0));
                }

            } else {
                // ── Transparent path: Weighted Blended OIT (McGuire & Bavoil 2013) ────
                // No depth test — all overlapping transparent fragments contribute.
                // Their weighted sum is composited over the opaque layer by pass5.

                uvec3 idx = face.indices;

                // Same interpolation as the opaque path.
                vec3 N = normalize(barycentric.x * vertices[idx.x].normal
                                 + barycentric.y * vertices[idx.y].normal
                                 + barycentric.z * vertices[idx.z].normal);

                vec3 worldPos = barycentric.x * vertices[idx.x].position
                              + barycentric.y * vertices[idx.y].position
                              + barycentric.z * vertices[idx.z].position;

                vec2 uv = barycentric.x * vertices[idx.x].uv
                        + barycentric.y * vertices[idx.y].uv
                        + barycentric.z * vertices[idx.z].uv;

                vec3 V = normalize(cameraPos - worldPos);

                vec3 albedo;
                if (mat.textureID >= 0) {
                    vec4 texSample = texture(textureAtlas, vec3(uv, float(mat.textureID)));
                    albedo = face.color * mat.albedo * texSample.rgb;
                } else {
                    albedo = face.color * mat.albedo;
                }

                vec3 color;
                if (shadingModel == 1)
                    color = shadePBR(albedo, N, V, worldPos, mat.metallic, mat.roughness);
                else
                    color = shadeBlinnPhong(albedo, N, V, worldPos);

                color += albedo * mat.emissive;

                // WBOIT weight function (Equation 9 from McGuire & Bavoil 2013).
                // Weight is large for near, high-alpha fragments and small for far,
                // low-alpha ones — this produces visually correct layering without sorting.
                // linearDepth maps NDC [-1,1] to view-space [0,1].
                float linearDepth = clamp((interpolatedDepth + 1.0) * 0.5, 0.0, 1.0);
                float depthSq     = linearDepth * linearDepth;
                float w = clamp(matAlpha * 8.0 + 0.01, 0.01, 3000.0)
                        * clamp(0.03 / (1e-5 + depthSq), 1e-2, 3e3);

                // Accumulate premultiplied-alpha weighted color into thread-local registers.
                // These are safe non-atomic writes — each pixel is handled by exactly one thread.
                localAccumR += color.r * matAlpha * w;
                localAccumG += color.g * matAlpha * w;
                localAccumB += color.b * matAlpha * w;
                localAccumA += matAlpha * w;

                // Multiply transmittance by (1 - alpha): product over all transparent frags
                // at this pixel gives the fraction of light that reaches the opaque layer.
                // reveal = 1.0: fully transparent (opaque surface shows through completely).
                // reveal → 0.0: covered by increasingly opaque transparent fragments.
                localReveal *= (1.0 - matAlpha);
            }
        }
    }

    // Write final OIT state for this pixel to the SSBO arrays.
    // floatBitsToUint() preserves the exact IEEE 754 bit pattern so pass5 can unpack
    // with uintBitsToFloat() without any loss of precision.
    //
    // This write is unconditional: empty-tile pixels write neutral values
    // (all zeros + reveal=1.0) so pass5 will leave them untouched.
    oitAccumR[pixelIdx] = floatBitsToUint(localAccumR);
    oitAccumG[pixelIdx] = floatBitsToUint(localAccumG);
    oitAccumB[pixelIdx] = floatBitsToUint(localAccumB);
    oitAccumA[pixelIdx] = floatBitsToUint(localAccumA);
    oitReveal[pixelIdx] = floatBitsToUint(localReveal);
}

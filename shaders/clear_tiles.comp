#version 430 core

// clear_tiles.comp — Phase 0b: Reset all per-tile triangle counters to zero.
//
// Each frame, pass1_count.comp increments tileCounters[] atomically as it discovers
// which tiles each triangle overlaps. If the counters are not zeroed first, the
// increments from the previous frame would accumulate, producing incorrect per-tile
// counts and ultimately incorrect prefix sum offsets and triangle list sizes.
//
// One thread per tile; numElements = total number of tiles for this viewport.
// The CPU dispatches ceil(numTiles / 256) groups of 256 threads.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Tile counter SSBO (binding 0): one uint per tile, atomically updated by pass1
layout(std430, binding = 0) buffer TileCounterBuffer {
    uint tileCounters[];
};

// Total number of tiles = numTilesX * numTilesY for the current viewport
uniform uint numElements;

void main() {
    uint globalID = gl_GlobalInvocationID.x;

    // Guard: extra threads in the last workgroup have no tile to clear
    if (globalID < numElements) {
        tileCounters[globalID] = 0;
    }
}
